# ============================================================
# Read Smart SMS — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Application ---
APP_NAME="Read Smart SMS"
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000

# --- Backend (PHP built-in server) ---
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sms_db
DB_USER=root
DB_PASS=                    # <-- Set your MySQL root password here
DB_CHARSET=utf8mb4

# --- JWT Authentication ---
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRY=86400            # 24 hours in seconds

# --- File Uploads ---
UPLOAD_MAX_SIZE=10485760    # 10 MB
UPLOAD_DIR=uploads/
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

# --- Email (optional — for notifications) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME="Read Smart SMS"
MAIL_FROM_ADDRESS=noreply@readsmart.edu

# --- Security ---
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=10
SESSION_LIFETIME=120

# --- Library ---
FINE_PER_DAY=5              # Rs 5 per day overdue fine
